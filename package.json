{
  "name": "@dschz/solid-ag-grid",
  "version": "36.0.0-next.7",
  "description": "AG Grid with 100% SolidJS rendering — Solid 2.x, AG Grid v36",
  "keywords": [
    "ag-grid",
    "data-grid",
    "datagrid",
    "grid",
    "solid",
    "solidjs",
    "table"
  ],
  "homepage": "https://github.com/dsnchz/solid-ag-grid",
  "bugs": {
    "url": "https://github.com/dsnchz/solid-ag-grid/issues"
  },
  "license": "MIT",
  "author": "Daniel Sanchez <dsanc89@icloud.com>",
  "contributors": [
    {
      "name": "Daniel Sanchez",
      "email": "dsanc89@icloud.com",
      "url": "https://github.com/dsnchz"
    },
    {
      "name": "Niall Crosby",
      "email": "niall.crosby@ag-grid.com"
    },
    {
      "name": "David Di Biase",
      "email": "dave.dibiase@gmail.com",
      "url": "https://github.com/davedbase"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsnchz/solid-ag-grid.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./dist/source/index.jsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite serve --config dev-playground/vite.config.ts",
    "clean": "rm -rf dist",
    "build": "pnpm clean && vite build && tsc -p tsconfig.dts.json && tsc -p tsconfig.source.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit --project ssr --project browser",
    "test:perf": "vitest run --project perf",
    "test:watch": "vitest --project unit --project ssr --project browser",
    "typecheck": "tsc --noEmit",
    "check:solid": "solid-checker --project tsconfig.json",
    "test:coverage": "vitest run --coverage --project unit --project ssr --project browser",
    "pkg:changeset": "changeset",
    "pkg:version": "changeset version && node scripts/sync-jsr-version.mjs",
    "pkg:publish": "pnpm build && changeset publish && node scripts/sync-pre-tag.mjs"
  },
  "dependencies": {
    "ag-stack": "36.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@solid-primitives/resize-observer": "4.0.0-next.7",
    "@solidjs/diagnostics": "2.0.0-rc.21",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.21",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ag-grid-community": "36.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.19.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "oxfmt": "0.78.0",
    "playwright": "^1.65.0",
    "solid-checker": "0.2.2",
    "solid-js": "2.0.0-rc.21",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.21",
    "ag-grid-community": "36.3.0",
    "solid-js": "^2.0.0-rc.21"
  },
  "packageManager": "pnpm@9.0.0"
}
